# Postgres connection string used by the app at runtime.
# On a pooled provider (Neon, Supabase) use the POOLED string here.
DATABASE_URL="postgresql://user:password@host/prompt_library?sslmode=require"

# Direct (unpooled) string, used only for migrations — pooled connections run
# in transaction mode and can't run them. Leave unset for plain Postgres;
# DATABASE_URL is then used for both.
# Neon's Vercel integration sets this variable for you.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/prompt_library?sslmode=require"

# API key for the AI-assisted "Optimize prompt" feature (MIN-17).
# Never prefix this with NEXT_PUBLIC_ — that would ship it to the browser.
ANTHROPIC_API_KEY=""

# Optional: defaults to claude-sonnet-5.
# OPTIMIZER_MODEL="claude-opus-5"
